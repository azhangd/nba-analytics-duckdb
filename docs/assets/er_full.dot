digraph er_full {
  graph [rankdir=TB, bgcolor=white, pad=0.3, nodesep=0.3, ranksep=0.3, fontname=Helvetica, fontsize=16];
  node [shape=plain, fontname=Helvetica, fontsize=11];
  edge [style=invis];
  legend [label=<<TABLE BORDER="1" COLOR="#cbd5e0" CELLBORDER="0" CELLSPACING="2" CELLPADDING="3"><TR><TD BGCOLOR="#2b6cb0"><FONT COLOR="white">silver</FONT></TD><TD ALIGN="LEFT">cleaned-up NBA data</TD></TR><TR><TD BGCOLOR="#2f855a"><FONT COLOR="white">gold</FONT></TD><TD ALIGN="LEFT">stats calculated from silver</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><B>bold</B>: primary key</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2">team_id → dim_teams: you can join team_id to dim_teams</TD></TR></TABLE>>];
  subgraph cluster_reference { label="silver: teams, players, coaches and injuries"; color="#2b6cb0"; fontcolor="#2b6cb0";
    silver__dim_coaches [label=<<TABLE BORDER="1" COLOR="#2b6cb0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="LEFT" BGCOLOR="#2b6cb0"><FONT COLOR="white"><B>dim_coaches</B></FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#2b6cb0"><FONT COLOR="#e2e8f0" POINT-SIZE="9">silver</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="coach_id_in" WIDTH="130"><B>coach_id</B></TD><TD ALIGN="LEFT" PORT="coach_id_out" WIDTH="130"></TD></TR></TABLE>>];
    silver__dim_players [label=<<TABLE BORDER="1" COLOR="#2b6cb0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="LEFT" BGCOLOR="#2b6cb0"><FONT COLOR="white"><B>dim_players</B></FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#2b6cb0"><FONT COLOR="#e2e8f0" POINT-SIZE="9">silver</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="player_id_in" WIDTH="130"><B>player_id</B></TD><TD ALIGN="LEFT" PORT="player_id_out" WIDTH="130"></TD></TR><TR><TD ALIGN="LEFT" PORT="current_team_id_in" WIDTH="130">current_team_id</TD><TD ALIGN="LEFT" PORT="current_team_id_out" WIDTH="130"><FONT COLOR="#718096">→ dim_teams</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="season_in" WIDTH="130">season</TD><TD ALIGN="LEFT" PORT="season_out" WIDTH="130"></TD></TR></TABLE>>];
    silver__dim_teams [label=<<TABLE BORDER="1" COLOR="#2b6cb0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="LEFT" BGCOLOR="#2b6cb0"><FONT COLOR="white"><B>dim_teams</B></FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#2b6cb0"><FONT COLOR="#e2e8f0" POINT-SIZE="9">silver</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="team_id_in" WIDTH="130"><B>team_id</B></TD><TD ALIGN="LEFT" PORT="team_id_out" WIDTH="130"></TD></TR></TABLE>>];
    silver__dim_injuries [label=<<TABLE BORDER="1" COLOR="#2b6cb0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="LEFT" BGCOLOR="#2b6cb0"><FONT COLOR="white"><B>dim_injuries</B></FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#2b6cb0"><FONT COLOR="#e2e8f0" POINT-SIZE="9">silver</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="athlete_espn_id_in" WIDTH="130">athlete_espn_id</TD><TD ALIGN="LEFT" PORT="athlete_espn_id_out" WIDTH="130"></TD></TR><TR><TD ALIGN="LEFT" PORT="player_id_in" WIDTH="130">player_id</TD><TD ALIGN="LEFT" PORT="player_id_out" WIDTH="130"><FONT COLOR="#718096">→ dim_players</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="team_id_in" WIDTH="130">team_id</TD><TD ALIGN="LEFT" PORT="team_id_out" WIDTH="130"><FONT COLOR="#718096">→ dim_teams</FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_silver_game { label="silver: game data"; color="#2b6cb0"; fontcolor="#2b6cb0";
    silver__fct_games [label=<<TABLE BORDER="1" COLOR="#2b6cb0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="LEFT" BGCOLOR="#2b6cb0"><FONT COLOR="white"><B>fct_games</B></FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#2b6cb0"><FONT COLOR="#e2e8f0" POINT-SIZE="9">silver</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="game_id_in" WIDTH="130"><B>game_id</B></TD><TD ALIGN="LEFT" PORT="game_id_out" WIDTH="130"></TD></TR><TR><TD ALIGN="LEFT" PORT="season_in" WIDTH="130">season</TD><TD ALIGN="LEFT" PORT="season_out" WIDTH="130"></TD></TR><TR><TD ALIGN="LEFT" PORT="league_id_in" WIDTH="130">league_id</TD><TD ALIGN="LEFT" PORT="league_id_out" WIDTH="130"></TD></TR><TR><TD ALIGN="LEFT" PORT="home_team_id_in" WIDTH="130">home_team_id</TD><TD ALIGN="LEFT" PORT="home_team_id_out" WIDTH="130"><FONT COLOR="#718096">→ dim_teams</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="away_team_id_in" WIDTH="130">away_team_id</TD><TD ALIGN="LEFT" PORT="away_team_id_out" WIDTH="130"><FONT COLOR="#718096">→ dim_teams</FONT></TD></TR></TABLE>>];
    silver__fct_boxscores [label=<<TABLE BORDER="1" COLOR="#2b6cb0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="LEFT" BGCOLOR="#2b6cb0"><FONT COLOR="white"><B>fct_boxscores</B></FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#2b6cb0"><FONT COLOR="#e2e8f0" POINT-SIZE="9">silver</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="game_id_in" WIDTH="130">game_id</TD><TD ALIGN="LEFT" PORT="game_id_out" WIDTH="130"><FONT COLOR="#718096">→ fct_games</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="player_id_in" WIDTH="130">player_id</TD><TD ALIGN="LEFT" PORT="player_id_out" WIDTH="130"><FONT COLOR="#718096">→ dim_players</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="team_id_in" WIDTH="130">team_id</TD><TD ALIGN="LEFT" PORT="team_id_out" WIDTH="130"><FONT COLOR="#718096">→ dim_teams</FONT></TD></TR></TABLE>>];
    silver__fct_game_detail [label=<<TABLE BORDER="1" COLOR="#2b6cb0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="LEFT" BGCOLOR="#2b6cb0"><FONT COLOR="white"><B>fct_game_detail</B></FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#2b6cb0"><FONT COLOR="#e2e8f0" POINT-SIZE="9">silver</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="game_id_in" WIDTH="130">game_id</TD><TD ALIGN="LEFT" PORT="game_id_out" WIDTH="130"><FONT COLOR="#718096">→ fct_games</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="team_id_in" WIDTH="130">team_id</TD><TD ALIGN="LEFT" PORT="team_id_out" WIDTH="130"><FONT COLOR="#718096">→ dim_teams</FONT></TD></TR></TABLE>>];
    silver__fct_lineups [label=<<TABLE BORDER="1" COLOR="#2b6cb0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="LEFT" BGCOLOR="#2b6cb0"><FONT COLOR="white"><B>fct_lineups</B></FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#2b6cb0"><FONT COLOR="#e2e8f0" POINT-SIZE="9">silver</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="game_id_in" WIDTH="130">game_id</TD><TD ALIGN="LEFT" PORT="game_id_out" WIDTH="130"><FONT COLOR="#718096">→ fct_games</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="team_id_in" WIDTH="130">team_id</TD><TD ALIGN="LEFT" PORT="team_id_out" WIDTH="130"><FONT COLOR="#718096">→ dim_teams</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="player_ids_str_in" WIDTH="130">player_ids_str</TD><TD ALIGN="LEFT" PORT="player_ids_str_out" WIDTH="130"></TD></TR></TABLE>>];
    silver__fct_play_by_play [label=<<TABLE BORDER="1" COLOR="#2b6cb0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="LEFT" BGCOLOR="#2b6cb0"><FONT COLOR="white"><B>fct_play_by_play</B></FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#2b6cb0"><FONT COLOR="#e2e8f0" POINT-SIZE="9">silver</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="game_id_in" WIDTH="130">game_id</TD><TD ALIGN="LEFT" PORT="game_id_out" WIDTH="130"><FONT COLOR="#718096">→ fct_games</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="action_id_in" WIDTH="130">action_id</TD><TD ALIGN="LEFT" PORT="action_id_out" WIDTH="130"></TD></TR><TR><TD ALIGN="LEFT" PORT="team_id_in" WIDTH="130">team_id</TD><TD ALIGN="LEFT" PORT="team_id_out" WIDTH="130"><FONT COLOR="#718096">→ dim_teams</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="player_id_in" WIDTH="130">player_id</TD><TD ALIGN="LEFT" PORT="player_id_out" WIDTH="130"><FONT COLOR="#718096">→ dim_players</FONT></TD></TR></TABLE>>];
    silver__fct_possessions [label=<<TABLE BORDER="1" COLOR="#2b6cb0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="LEFT" BGCOLOR="#2b6cb0"><FONT COLOR="white"><B>fct_possessions</B></FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#2b6cb0"><FONT COLOR="#e2e8f0" POINT-SIZE="9">silver</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="game_id_in" WIDTH="130">game_id</TD><TD ALIGN="LEFT" PORT="game_id_out" WIDTH="130"><FONT COLOR="#718096">→ fct_games</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="offense_team_id_in" WIDTH="130">offense_team_id</TD><TD ALIGN="LEFT" PORT="offense_team_id_out" WIDTH="130"><FONT COLOR="#718096">→ dim_teams</FONT></TD></TR></TABLE>>];
    silver__fct_shots [label=<<TABLE BORDER="1" COLOR="#2b6cb0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="LEFT" BGCOLOR="#2b6cb0"><FONT COLOR="white"><B>fct_shots</B></FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#2b6cb0"><FONT COLOR="#e2e8f0" POINT-SIZE="9">silver</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="game_id_in" WIDTH="130">game_id</TD><TD ALIGN="LEFT" PORT="game_id_out" WIDTH="130"><FONT COLOR="#718096">→ fct_games</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="game_event_id_in" WIDTH="130">game_event_id</TD><TD ALIGN="LEFT" PORT="game_event_id_out" WIDTH="130"></TD></TR><TR><TD ALIGN="LEFT" PORT="player_id_in" WIDTH="130">player_id</TD><TD ALIGN="LEFT" PORT="player_id_out" WIDTH="130"><FONT COLOR="#718096">→ dim_players</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="team_id_in" WIDTH="130">team_id</TD><TD ALIGN="LEFT" PORT="team_id_out" WIDTH="130"><FONT COLOR="#718096">→ dim_teams</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="season_in" WIDTH="130">season</TD><TD ALIGN="LEFT" PORT="season_out" WIDTH="130"></TD></TR></TABLE>>];
  }
  subgraph cluster_silver_season { label="silver: season data"; color="#2b6cb0"; fontcolor="#2b6cb0";
    silver__fct_defense_play_types [label=<<TABLE BORDER="1" COLOR="#2b6cb0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="LEFT" BGCOLOR="#2b6cb0"><FONT COLOR="white"><B>fct_defense_play_types</B></FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#2b6cb0"><FONT COLOR="#e2e8f0" POINT-SIZE="9">silver</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="season_in" WIDTH="130">season</TD><TD ALIGN="LEFT" PORT="season_out" WIDTH="130"></TD></TR><TR><TD ALIGN="LEFT" PORT="player_id_in" WIDTH="130">player_id</TD><TD ALIGN="LEFT" PORT="player_id_out" WIDTH="130"><FONT COLOR="#718096">→ dim_players</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="team_id_in" WIDTH="130">team_id</TD><TD ALIGN="LEFT" PORT="team_id_out" WIDTH="130"><FONT COLOR="#718096">→ dim_teams</FONT></TD></TR></TABLE>>];
    silver__fct_hustle [label=<<TABLE BORDER="1" COLOR="#2b6cb0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="LEFT" BGCOLOR="#2b6cb0"><FONT COLOR="white"><B>fct_hustle</B></FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#2b6cb0"><FONT COLOR="#e2e8f0" POINT-SIZE="9">silver</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="season_in" WIDTH="130">season</TD><TD ALIGN="LEFT" PORT="season_out" WIDTH="130"></TD></TR><TR><TD ALIGN="LEFT" PORT="player_id_in" WIDTH="130">player_id</TD><TD ALIGN="LEFT" PORT="player_id_out" WIDTH="130"><FONT COLOR="#718096">→ dim_players</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="team_id_in" WIDTH="130">team_id</TD><TD ALIGN="LEFT" PORT="team_id_out" WIDTH="130"><FONT COLOR="#718096">→ dim_teams</FONT></TD></TR></TABLE>>];
    silver__fct_matchups [label=<<TABLE BORDER="1" COLOR="#2b6cb0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="LEFT" BGCOLOR="#2b6cb0"><FONT COLOR="white"><B>fct_matchups</B></FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#2b6cb0"><FONT COLOR="#e2e8f0" POINT-SIZE="9">silver</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="season_in" WIDTH="130">season</TD><TD ALIGN="LEFT" PORT="season_out" WIDTH="130"></TD></TR><TR><TD ALIGN="LEFT" PORT="off_player_id_in" WIDTH="130">off_player_id</TD><TD ALIGN="LEFT" PORT="off_player_id_out" WIDTH="130"><FONT COLOR="#718096">→ dim_players</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="def_player_id_in" WIDTH="130">def_player_id</TD><TD ALIGN="LEFT" PORT="def_player_id_out" WIDTH="130"><FONT COLOR="#718096">→ dim_players</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="off_team_id_in" WIDTH="130">off_team_id</TD><TD ALIGN="LEFT" PORT="off_team_id_out" WIDTH="130"><FONT COLOR="#718096">→ dim_teams</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="def_team_id_in" WIDTH="130">def_team_id</TD><TD ALIGN="LEFT" PORT="def_team_id_out" WIDTH="130"><FONT COLOR="#718096">→ dim_teams</FONT></TD></TR></TABLE>>];
    silver__fct_team_coach_seasons [label=<<TABLE BORDER="1" COLOR="#2b6cb0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="LEFT" BGCOLOR="#2b6cb0"><FONT COLOR="white"><B>fct_team_coach_seasons</B></FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#2b6cb0"><FONT COLOR="#e2e8f0" POINT-SIZE="9">silver</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="team_id_in" WIDTH="130">team_id</TD><TD ALIGN="LEFT" PORT="team_id_out" WIDTH="130"><FONT COLOR="#718096">→ dim_teams</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="season_in" WIDTH="130">season</TD><TD ALIGN="LEFT" PORT="season_out" WIDTH="130"></TD></TR><TR><TD ALIGN="LEFT" PORT="coach_id_in" WIDTH="130">coach_id</TD><TD ALIGN="LEFT" PORT="coach_id_out" WIDTH="130"><FONT COLOR="#718096">→ dim_coaches</FONT></TD></TR></TABLE>>];
    silver__fct_tracking [label=<<TABLE BORDER="1" COLOR="#2b6cb0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="LEFT" BGCOLOR="#2b6cb0"><FONT COLOR="white"><B>fct_tracking</B></FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#2b6cb0"><FONT COLOR="#e2e8f0" POINT-SIZE="9">silver</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="season_in" WIDTH="130">season</TD><TD ALIGN="LEFT" PORT="season_out" WIDTH="130"></TD></TR><TR><TD ALIGN="LEFT" PORT="player_id_in" WIDTH="130">player_id</TD><TD ALIGN="LEFT" PORT="player_id_out" WIDTH="130"><FONT COLOR="#718096">→ dim_players</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="team_id_in" WIDTH="130">team_id</TD><TD ALIGN="LEFT" PORT="team_id_out" WIDTH="130"><FONT COLOR="#718096">→ dim_teams</FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_gold_game { label="gold: game stats"; color="#2f855a"; fontcolor="#2f855a";
    gold__player_game_rolling_stats [label=<<TABLE BORDER="1" COLOR="#2f855a" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="LEFT" BGCOLOR="#2f855a"><FONT COLOR="white"><B>player_game_rolling_stats</B></FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#2f855a"><FONT COLOR="#e2e8f0" POINT-SIZE="9">gold</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="player_id_in" WIDTH="130">player_id</TD><TD ALIGN="LEFT" PORT="player_id_out" WIDTH="130"><FONT COLOR="#718096">→ dim_players</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="season_in" WIDTH="130">season</TD><TD ALIGN="LEFT" PORT="season_out" WIDTH="130"></TD></TR><TR><TD ALIGN="LEFT" PORT="game_id_in" WIDTH="130">game_id</TD><TD ALIGN="LEFT" PORT="game_id_out" WIDTH="130"><FONT COLOR="#718096">→ fct_games</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="team_id_in" WIDTH="130">team_id</TD><TD ALIGN="LEFT" PORT="team_id_out" WIDTH="130"><FONT COLOR="#718096">→ dim_teams</FONT></TD></TR></TABLE>>];
