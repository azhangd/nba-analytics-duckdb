digraph schema {
  graph [rankdir=TB, bgcolor=white, pad=0.3, nodesep=0.5, ranksep=0.5];
  node [shape=plain, fontname=Helvetica];
  edge [color="#718096", arrowsize=0.8, penwidth=1.5];
  bronze [label=<<TABLE BORDER="1" COLOR="#b7791f" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#b7791f" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="16"><B>bronze: raw API responses</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>boxscores</B></TD><TD ALIGN="LEFT"><FONT COLOR="#4a5568">Box score JSON per game</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>coaches</B></TD><TD ALIGN="LEFT"><FONT COLOR="#4a5568">Coaching staffs by season</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>defense</B></TD><TD ALIGN="LEFT"><FONT COLOR="#4a5568">Defensive play-type JSON</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>game_detail</B></TD><TD ALIGN="LEFT"><FONT COLOR="#4a5568">Game summary JSON</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>hustle</B></TD><TD ALIGN="LEFT"><FONT COLOR="#4a5568">Hustle stats JSON per season</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>injuries</B></TD><TD ALIGN="LEFT"><FONT COLOR="#4a5568">Daily injury report JSON</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>matchups</B></TD><TD ALIGN="LEFT"><FONT COLOR="#4a5568">Matchup JSON per team</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>play_by_play</B></TD><TD ALIGN="LEFT"><FONT COLOR="#4a5568">Play-by-play JSON per game</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>rosters</B></TD><TD ALIGN="LEFT"><FONT COLOR="#4a5568">Team rosters by season</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>schedule</B></TD><TD ALIGN="LEFT"><FONT COLOR="#4a5568">Game dates, teams and scores</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>shot_charts</B></TD><TD ALIGN="LEFT"><FONT COLOR="#4a5568">Shot chart JSON per game and team</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>tracking_stats</B></TD><TD ALIGN="LEFT"><FONT COLOR="#4a5568">Player tracking JSON by category</FONT></TD></TR></TABLE>>];
  silver [label=<<TABLE BORDER="1" COLOR="#2b6cb0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#2b6cb0" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="16"><B>silver: cleaned games, players and events</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>dim_coaches</B></TD><TD ALIGN="LEFT"><FONT COLOR="#4a5568">Coach names, school and birth date</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>dim_injuries</B></TD><TD ALIGN="LEFT"><FONT COLOR="#4a5568">Current injuries with status, type and return date</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>dim_player_external_identities</B></TD><TD ALIGN="LEFT"><FONT COLOR="#4a5568">Wikidata and Wikipedia IDs for each player</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>dim_players</B></TD><TD ALIGN="LEFT"><FONT COLOR="#4a5568">Position, height, weight and current team</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>dim_teams</B></TD><TD ALIGN="LEFT"><FONT COLOR="#4a5568">Team names, conference and division</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>fct_boxscores</B></TD><TD ALIGN="LEFT"><FONT COLOR="#4a5568">Traditional and advanced stats per player per game</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>fct_defense_play_types</B></TD><TD ALIGN="LEFT"><FONT COLOR="#4a5568">Defensive efficiency by play type</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>fct_game_detail</B></TD><TD ALIGN="LEFT"><FONT COLOR="#4a5568">Points off turnovers, second chance, fast break and paint</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>fct_games</B></TD><TD ALIGN="LEFT"><FONT COLOR="#4a5568">Each game with date, teams, score and game type</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>fct_hustle</B></TD><TD ALIGN="LEFT"><FONT COLOR="#4a5568">Contests, deflections, screen assists and box-outs</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>fct_lineups</B></TD><TD ALIGN="LEFT"><FONT COLOR="#4a5568">Lineup stints with points for and against</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>fct_matchups</B></TD><TD ALIGN="LEFT"><FONT COLOR="#4a5568">Who guarded whom, with points and shooting</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>fct_play_by_play</B></TD><TD ALIGN="LEFT"><FONT COLOR="#4a5568">Every play with type, player, score and location</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>fct_possessions</B></TD><TD ALIGN="LEFT"><FONT COLOR="#4a5568">Every possession with how it started and ended</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>fct_shots</B></TD><TD ALIGN="LEFT"><FONT COLOR="#4a5568">Every shot with zone, distance, location and result</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>fct_team_coach_seasons</B></TD><TD ALIGN="LEFT"><FONT COLOR="#4a5568">Coaching staff for each team and season</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>fct_tracking</B></TD><TD ALIGN="LEFT"><FONT COLOR="#4a5568">Player tracking stats by category</FONT></TD></TR></TABLE>>];
  summer [label=<<TABLE BORDER="1" COLOR="#2b6cb0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#2b6cb0" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="16"><B>silver: Summer League</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>summer_league_boxscores</B></TD><TD ALIGN="LEFT"><FONT COLOR="#4a5568">Summer League box scores</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>summer_league_games</B></TD><TD ALIGN="LEFT"><FONT COLOR="#4a5568">Summer League games</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>summer_league_play_by_play</B></TD><TD ALIGN="LEFT"><FONT COLOR="#4a5568">Summer League play-by-play</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>summer_league_shots</B></TD><TD ALIGN="LEFT"><FONT COLOR="#4a5568">Summer League shots</FONT></TD></TR></TABLE>>];
  player [label=<<TABLE BORDER="1" COLOR="#2f855a" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#2f855a" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="16"><B>gold: players</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>player_combo_season_stats</B></TD><TD ALIGN="LEFT"><FONT COLOR="#4a5568">Net rating of two- and three-player combinations</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>player_game_rolling_stats</B></TD><TD ALIGN="LEFT"><FONT COLOR="#4a5568">Last 3, 5 and 10 game averages and hot or cold flags</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>player_game_stats</B></TD><TD ALIGN="LEFT"><FONT COLOR="#4a5568">Game logs with shot zones and game score</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>player_jersey_rank_snapshots</B></TD><TD ALIGN="LEFT"><FONT COLOR="#4a5568">Jersey sales rankings</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>player_media_mentions_daily</B></TD><TD ALIGN="LEFT"><FONT COLOR="#4a5568">Daily news mentions and tone</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>player_pageviews_daily</B></TD><TD ALIGN="LEFT"><FONT COLOR="#4a5568">Daily Wikipedia page views</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>player_season_archetypes</B></TD><TD ALIGN="LEFT"><FONT COLOR="#4a5568">Offensive role, such as creator or stretch shooter</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>player_season_clutch_stats</B></TD><TD ALIGN="LEFT"><FONT COLOR="#4a5568">Scoring in clutch time</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>player_season_embeddings</B></TD><TD ALIGN="LEFT"><FONT COLOR="#4a5568">PCA components and style clusters</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>player_season_feature_matrix</B></TD><TD ALIGN="LEFT"><FONT COLOR="#4a5568">One wide row per player season for modeling</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>player_season_load_management</B></TD><TD ALIGN="LEFT"><FONT COLOR="#4a5568">Minutes and workload</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>player_season_mvp_ladder</B></TD><TD ALIGN="LEFT"><FONT COLOR="#4a5568">MVP-style composite ranking</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>player_season_on_off_stats</B></TD><TD ALIGN="LEFT"><FONT COLOR="#4a5568">Net rating with the player on and off the court</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>player_season_rapm</B></TD><TD ALIGN="LEFT"><FONT COLOR="#4a5568">Ridge-regression RAPM with confidence intervals</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>player_season_shot_profile</B></TD><TD ALIGN="LEFT"><FONT COLOR="#4a5568">Shot mix and FG% by zone</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>player_season_similarity</B></TD><TD ALIGN="LEFT"><FONT COLOR="#4a5568">Most similar players each season</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>player_season_split_stats</B></TD><TD ALIGN="LEFT"><FONT COLOR="#4a5568">Splits by home or away, result, month and rest</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>player_season_stats</B></TD><TD ALIGN="LEFT"><FONT COLOR="#4a5568">Season averages, percentiles, BPM and VORP</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>player_season_stats_base</B></TD><TD ALIGN="LEFT"><FONT COLOR="#4a5568">Season averages, shooting and percentiles</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>player_zone_season_shot_quality</B></TD><TD ALIGN="LEFT"><FONT COLOR="#4a5568">Actual vs. expected FG% by zone</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>player_zone_season_shot_quality_trained</B></TD><TD ALIGN="LEFT"><FONT COLOR="#4a5568">Actual vs. expected FG% by zone, from a trained model</FONT></TD></TR></TABLE>>];
  team [label=<<TABLE BORDER="1" COLOR="#2f855a" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#2f855a" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="16"><B>gold: teams</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>team_game_elo_history</B></TD><TD ALIGN="LEFT"><FONT COLOR="#4a5568">Elo before and after each game</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>team_game_stats</B></TD><TD ALIGN="LEFT"><FONT COLOR="#4a5568">Game logs with score, margin and ratings</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>team_season_ato_stats</B></TD><TD ALIGN="LEFT"><FONT COLOR="#4a5568">Offense and defense after timeouts</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>team_season_clutch_stats</B></TD><TD ALIGN="LEFT"><FONT COLOR="#4a5568">Points per possession in clutch time</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>team_season_elo</B></TD><TD ALIGN="LEFT"><FONT COLOR="#4a5568">Elo rating and projected wins</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>team_season_feature_matrix</B></TD><TD ALIGN="LEFT"><FONT COLOR="#4a5568">One wide row per team season for modeling</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>team_season_four_factors</B></TD><TD ALIGN="LEFT"><FONT COLOR="#4a5568">Four factors, pace and Pythagorean wins</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>team_season_opponent_scouting</B></TD><TD ALIGN="LEFT"><FONT COLOR="#4a5568">Record and margin against each opponent</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>team_season_percentile_ranks</B></TD><TD ALIGN="LEFT"><FONT COLOR="#4a5568">Percentile ranks for the four factors and pace</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>team_season_play_type_splits</B></TD><TD ALIGN="LEFT"><FONT COLOR="#4a5568">Play types by period, margin and clutch</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>team_season_play_type_stats</B></TD><TD ALIGN="LEFT"><FONT COLOR="#4a5568">Points per possession by play type</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>team_season_shot_profile</B></TD><TD ALIGN="LEFT"><FONT COLOR="#4a5568">Shot mix and FG% by zone</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>team_season_starter_bench_stats</B></TD><TD ALIGN="LEFT"><FONT COLOR="#4a5568">Starters vs. bench</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>team_season_timeout_stats</B></TD><TD ALIGN="LEFT"><FONT COLOR="#4a5568">Timeouts by quarter and in the clutch</FONT></TD></TR></TABLE>>];
  other [label=<<TABLE BORDER="1" COLOR="#2f855a" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#2f855a" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="16"><B>gold: lineups, games and models</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>game_flow_snapshots</B></TD><TD ALIGN="LEFT"><FONT COLOR="#4a5568">Score and home win probability through each game</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>lineup_season_stats</B></TD><TD ALIGN="LEFT"><FONT COLOR="#4a5568">Five-player lineup minutes and net rating</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>model_artifacts</B></TD><TD ALIGN="LEFT"><FONT COLOR="#4a5568">Metadata for trained models</FONT></TD></TR></TABLE>>];
  bronze -> silver;
  bronze -> summer;
  silver -> player;
  silver -> team;
  team -> other [style=invis];
}
