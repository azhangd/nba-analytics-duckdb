digraph er_core {
  graph [rankdir=LR, bgcolor=white, pad=0.3, nodesep=0.3, ranksep=0.9, newrank=true, splines=polyline,
         fontname=Helvetica, fontsize=16];
  node [shape=plain, fontname=Helvetica, fontsize=11];
  edge [color="#a0aec0", arrowhead=crow, arrowsize=0.7, penwidth=1.2];
  { rank=same;
    silver__dim_teams [label=<<TABLE BORDER="1" COLOR="#2b6cb0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="LEFT" BGCOLOR="#2b6cb0"><FONT COLOR="white"><B>dim_teams</B></FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#2b6cb0"><FONT COLOR="#e2e8f0" POINT-SIZE="9">silver</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="team_id_in"><B>team_id</B></TD><TD ALIGN="LEFT" PORT="team_id_out"></TD></TR><TR><TD ALIGN="LEFT" PORT="abbreviation_in">abbreviation</TD><TD ALIGN="LEFT" PORT="abbreviation_out"></TD></TR><TR><TD ALIGN="LEFT" PORT="full_name_in">full_name</TD><TD ALIGN="LEFT" PORT="full_name_out"></TD></TR></TABLE>>];
    silver__dim_players [label=<<TABLE BORDER="1" COLOR="#2b6cb0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="LEFT" BGCOLOR="#2b6cb0"><FONT COLOR="white"><B>dim_players</B></FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#2b6cb0"><FONT COLOR="#e2e8f0" POINT-SIZE="9">silver</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="player_id_in"><B>player_id</B></TD><TD ALIGN="LEFT" PORT="player_id_out"></TD></TR><TR><TD ALIGN="LEFT" PORT="full_name_in">full_name</TD><TD ALIGN="LEFT" PORT="full_name_out"></TD></TR><TR><TD ALIGN="LEFT" PORT="position_in">position</TD><TD ALIGN="LEFT" PORT="position_out"></TD></TR><TR><TD ALIGN="LEFT" PORT="current_team_id_in">current_team_id</TD><TD ALIGN="LEFT" PORT="current_team_id_out"><FONT COLOR="#718096">→ dim_teams</FONT></TD></TR></TABLE>>];
    legend [label=<<TABLE BORDER="1" COLOR="#cbd5e0" CELLBORDER="0" CELLSPACING="2" CELLPADDING="3"><TR><TD BGCOLOR="#2b6cb0"><FONT COLOR="white">silver</FONT></TD><TD ALIGN="LEFT">cleaned-up NBA data</TD></TR><TR><TD BGCOLOR="#2f855a"><FONT COLOR="white">gold</FONT></TD><TD ALIGN="LEFT">stats calculated from silver</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><B>bold</B>: primary key</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2">team_id → dim_teams: you can join team_id to dim_teams</TD></TR></TABLE>>];
  }
  { rank=same;
    silver__fct_games [label=<<TABLE BORDER="1" COLOR="#2b6cb0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="LEFT" BGCOLOR="#2b6cb0"><FONT COLOR="white"><B>fct_games</B></FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#2b6cb0"><FONT COLOR="#e2e8f0" POINT-SIZE="9">silver</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="game_id_in"><B>game_id</B></TD><TD ALIGN="LEFT" PORT="game_id_out"></TD></TR><TR><TD ALIGN="LEFT" PORT="season_in">season</TD><TD ALIGN="LEFT" PORT="season_out"></TD></TR><TR><TD ALIGN="LEFT" PORT="game_date_in">game_date</TD><TD ALIGN="LEFT" PORT="game_date_out"></TD></TR><TR><TD ALIGN="LEFT" PORT="game_type_in">game_type</TD><TD ALIGN="LEFT" PORT="game_type_out"></TD></TR><TR><TD ALIGN="LEFT" PORT="home_team_id_in">home_team_id</TD><TD ALIGN="LEFT" PORT="home_team_id_out"></TD></TR><TR><TD ALIGN="LEFT" PORT="away_team_id_in">away_team_id</TD><TD ALIGN="LEFT" PORT="away_team_id_out"></TD></TR><TR><TD ALIGN="LEFT" PORT="home_score_in">home_score</TD><TD ALIGN="LEFT" PORT="home_score_out"></TD></TR><TR><TD ALIGN="LEFT" PORT="away_score_in">away_score</TD><TD ALIGN="LEFT" PORT="away_score_out"></TD></TR></TABLE>>];
  }
  { rank=same;
    silver__fct_possessions [label=<<TABLE BORDER="1" COLOR="#2b6cb0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="LEFT" BGCOLOR="#2b6cb0"><FONT COLOR="white"><B>fct_possessions</B></FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#2b6cb0"><FONT COLOR="#e2e8f0" POINT-SIZE="9">silver</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="game_id_in"><B>game_id</B></TD><TD ALIGN="LEFT" PORT="game_id_out"></TD></TR><TR><TD ALIGN="LEFT" PORT="possession_number_in"><B>possession_number</B></TD><TD ALIGN="LEFT" PORT="possession_number_out"></TD></TR><TR><TD ALIGN="LEFT" PORT="offense_team_id_in">offense_team_id</TD><TD ALIGN="LEFT" PORT="offense_team_id_out"><FONT COLOR="#718096">→ dim_teams</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="start_type_in">start_type</TD><TD ALIGN="LEFT" PORT="start_type_out"></TD></TR><TR><TD ALIGN="LEFT" PORT="end_type_in">end_type</TD><TD ALIGN="LEFT" PORT="end_type_out"></TD></TR><TR><TD ALIGN="LEFT" PORT="points_scored_in">points_scored</TD><TD ALIGN="LEFT" PORT="points_scored_out"></TD></TR></TABLE>>];
    silver__fct_play_by_play [label=<<TABLE BORDER="1" COLOR="#2b6cb0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="LEFT" BGCOLOR="#2b6cb0"><FONT COLOR="white"><B>fct_play_by_play</B></FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#2b6cb0"><FONT COLOR="#e2e8f0" POINT-SIZE="9">silver</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="game_id_in"><B>game_id</B></TD><TD ALIGN="LEFT" PORT="game_id_out"></TD></TR><TR><TD ALIGN="LEFT" PORT="action_id_in"><B>action_id</B></TD><TD ALIGN="LEFT" PORT="action_id_out"></TD></TR><TR><TD ALIGN="LEFT" PORT="period_in">period</TD><TD ALIGN="LEFT" PORT="period_out"></TD></TR><TR><TD ALIGN="LEFT" PORT="team_id_in">team_id</TD><TD ALIGN="LEFT" PORT="team_id_out"><FONT COLOR="#718096">→ dim_teams</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="player_id_in">player_id</TD><TD ALIGN="LEFT" PORT="player_id_out"><FONT COLOR="#718096">→ dim_players</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="action_type_in">action_type</TD><TD ALIGN="LEFT" PORT="action_type_out"></TD></TR></TABLE>>];
    silver__fct_shots [label=<<TABLE BORDER="1" COLOR="#2b6cb0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="LEFT" BGCOLOR="#2b6cb0"><FONT COLOR="white"><B>fct_shots</B></FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#2b6cb0"><FONT COLOR="#e2e8f0" POINT-SIZE="9">silver</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="game_id_in"><B>game_id</B></TD><TD ALIGN="LEFT" PORT="game_id_out"></TD></TR><TR><TD ALIGN="LEFT" PORT="game_event_id_in"><B>game_event_id</B></TD><TD ALIGN="LEFT" PORT="game_event_id_out"></TD></TR><TR><TD ALIGN="LEFT" PORT="player_id_in">player_id</TD><TD ALIGN="LEFT" PORT="player_id_out"><FONT COLOR="#718096">→ dim_players</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="team_id_in">team_id</TD><TD ALIGN="LEFT" PORT="team_id_out"><FONT COLOR="#718096">→ dim_teams</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="shot_zone_basic_in">shot_zone_basic</TD><TD ALIGN="LEFT" PORT="shot_zone_basic_out"></TD></TR><TR><TD ALIGN="LEFT" PORT="shot_made_in">shot_made</TD><TD ALIGN="LEFT" PORT="shot_made_out"></TD></TR></TABLE>>];
    silver__fct_lineups [label=<<TABLE BORDER="1" COLOR="#2b6cb0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="LEFT" BGCOLOR="#2b6cb0"><FONT COLOR="white"><B>fct_lineups</B></FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#2b6cb0"><FONT COLOR="#e2e8f0" POINT-SIZE="9">silver</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="game_id_in"><B>game_id</B></TD><TD ALIGN="LEFT" PORT="game_id_out"></TD></TR><TR><TD ALIGN="LEFT" PORT="stint_number_in"><B>stint_number</B></TD><TD ALIGN="LEFT" PORT="stint_number_out"></TD></TR><TR><TD ALIGN="LEFT" PORT="team_id_in">team_id</TD><TD ALIGN="LEFT" PORT="team_id_out"><FONT COLOR="#718096">→ dim_teams</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="player_ids_str_in">player_ids_str</TD><TD ALIGN="LEFT" PORT="player_ids_str_out"></TD></TR><TR><TD ALIGN="LEFT" PORT="points_for_in">points_for</TD><TD ALIGN="LEFT" PORT="points_for_out"></TD></TR></TABLE>>];
    silver__fct_boxscores [label=<<TABLE BORDER="1" COLOR="#2b6cb0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="LEFT" BGCOLOR="#2b6cb0"><FONT COLOR="white"><B>fct_boxscores</B></FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#2b6cb0"><FONT COLOR="#e2e8f0" POINT-SIZE="9">silver</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="game_id_in"><B>game_id</B></TD><TD ALIGN="LEFT" PORT="game_id_out"></TD></TR><TR><TD ALIGN="LEFT" PORT="player_id_in"><B>player_id</B></TD><TD ALIGN="LEFT" PORT="player_id_out"></TD></TR><TR><TD ALIGN="LEFT" PORT="team_id_in">team_id</TD><TD ALIGN="LEFT" PORT="team_id_out"><FONT COLOR="#718096">→ dim_teams</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="minutes_in">minutes</TD><TD ALIGN="LEFT" PORT="minutes_out"></TD></TR><TR><TD ALIGN="LEFT" PORT="pts_in">pts</TD><TD ALIGN="LEFT" PORT="pts_out"></TD></TR><TR><TD ALIGN="LEFT" PORT="usg_pct_in">usg_pct</TD><TD ALIGN="LEFT" PORT="usg_pct_out"></TD></TR></TABLE>>];
  }
  { rank=same;
    gold__team_game_stats [label=<<TABLE BORDER="1" COLOR="#2f855a" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="LEFT" BGCOLOR="#2f855a"><FONT COLOR="white"><B>team_game_stats</B></FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#2f855a"><FONT COLOR="#e2e8f0" POINT-SIZE="9">gold</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="game_id_in"><B>game_id</B></TD><TD ALIGN="LEFT" PORT="game_id_out"><FONT COLOR="#718096">→ fct_games</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="team_id_in"><B>team_id</B></TD><TD ALIGN="LEFT" PORT="team_id_out"><FONT COLOR="#718096">→ dim_teams</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="season_in">season</TD><TD ALIGN="LEFT" PORT="season_out"></TD></TR><TR><TD ALIGN="LEFT" PORT="margin_in">margin</TD><TD ALIGN="LEFT" PORT="margin_out"></TD></TR><TR><TD ALIGN="LEFT" PORT="net_rtg_in">net_rtg</TD><TD ALIGN="LEFT" PORT="net_rtg_out"></TD></TR></TABLE>>];
    gold__player_game_stats [label=<<TABLE BORDER="1" COLOR="#2f855a" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="LEFT" BGCOLOR="#2f855a"><FONT COLOR="white"><B>player_game_stats</B></FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#2f855a"><FONT COLOR="#e2e8f0" POINT-SIZE="9">gold</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="game_id_in"><B>game_id</B></TD><TD ALIGN="LEFT" PORT="game_id_out"><FONT COLOR="#718096">→ fct_games</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="player_id_in"><B>player_id</B></TD><TD ALIGN="LEFT" PORT="player_id_out"><FONT COLOR="#718096">→ dim_players</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="team_id_in">team_id</TD><TD ALIGN="LEFT" PORT="team_id_out"><FONT COLOR="#718096">→ dim_teams</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="game_score_in">game_score</TD><TD ALIGN="LEFT" PORT="game_score_out"></TD></TR></TABLE>>];
  }
  { rank=same;
    gold__team_season_four_factors [label=<<TABLE BORDER="1" COLOR="#2f855a" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="LEFT" BGCOLOR="#2f855a"><FONT COLOR="white"><B>team_season_four_factors</B></FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#2f855a"><FONT COLOR="#e2e8f0" POINT-SIZE="9">gold</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="team_id_in"><B>team_id</B></TD><TD ALIGN="LEFT" PORT="team_id_out"><FONT COLOR="#718096">→ dim_teams</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="season_in"><B>season</B></TD><TD ALIGN="LEFT" PORT="season_out"></TD></TR><TR><TD ALIGN="LEFT" PORT="pace_in">pace</TD><TD ALIGN="LEFT" PORT="pace_out"></TD></TR><TR><TD ALIGN="LEFT" PORT="off_efg_pct_in">off_efg_pct</TD><TD ALIGN="LEFT" PORT="off_efg_pct_out"></TD></TR><TR><TD ALIGN="LEFT" PORT="pyth_wins_in">pyth_wins</TD><TD ALIGN="LEFT" PORT="pyth_wins_out"></TD></TR></TABLE>>];
    gold__team_season_elo [label=<<TABLE BORDER="1" COLOR="#2f855a" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="LEFT" BGCOLOR="#2f855a"><FONT COLOR="white"><B>team_season_elo</B></FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#2f855a"><FONT COLOR="#e2e8f0" POINT-SIZE="9">gold</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="team_id_in"><B>team_id</B></TD><TD ALIGN="LEFT" PORT="team_id_out"><FONT COLOR="#718096">→ dim_teams</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="season_in"><B>season</B></TD><TD ALIGN="LEFT" PORT="season_out"></TD></TR><TR><TD ALIGN="LEFT" PORT="elo_rating_in">elo_rating</TD><TD ALIGN="LEFT" PORT="elo_rating_out"></TD></TR><TR><TD ALIGN="LEFT" PORT="projected_wins_in">projected_wins</TD><TD ALIGN="LEFT" PORT="projected_wins_out"></TD></TR></TABLE>>];
    gold__lineup_season_stats [label=<<TABLE BORDER="1" COLOR="#2f855a" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="LEFT" BGCOLOR="#2f855a"><FONT COLOR="white"><B>lineup_season_stats</B></FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#2f855a"><FONT COLOR="#e2e8f0" POINT-SIZE="9">gold</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="team_id_in"><B>team_id</B></TD><TD ALIGN="LEFT" PORT="team_id_out"><FONT COLOR="#718096">→ dim_teams</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="season_in"><B>season</B></TD><TD ALIGN="LEFT" PORT="season_out"></TD></TR><TR><TD ALIGN="LEFT" PORT="player_ids_str_in"><B>player_ids_str</B></TD><TD ALIGN="LEFT" PORT="player_ids_str_out"></TD></TR><TR><TD ALIGN="LEFT" PORT="net_rating_per_48_in">net_rating_per_48</TD><TD ALIGN="LEFT" PORT="net_rating_per_48_out"></TD></TR></TABLE>>];
    gold__player_season_stats [label=<<TABLE BORDER="1" COLOR="#2f855a" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="LEFT" BGCOLOR="#2f855a"><FONT COLOR="white"><B>player_season_stats</B></FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#2f855a"><FONT COLOR="#e2e8f0" POINT-SIZE="9">gold</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="player_id_in"><B>player_id</B></TD><TD ALIGN="LEFT" PORT="player_id_out"><FONT COLOR="#718096">→ dim_players</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="season_in"><B>season</B></TD><TD ALIGN="LEFT" PORT="season_out"></TD></TR><TR><TD ALIGN="LEFT" PORT="team_id_in">team_id</TD><TD ALIGN="LEFT" PORT="team_id_out"><FONT COLOR="#718096">→ dim_teams</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ppg_in">ppg</TD><TD ALIGN="LEFT" PORT="ppg_out"></TD></TR><TR><TD ALIGN="LEFT" PORT="bpm_approx_in">bpm_approx</TD><TD ALIGN="LEFT" PORT="bpm_approx_out"></TD></TR><TR><TD ALIGN="LEFT" PORT="vorp_approx_in">vorp_approx</TD><TD ALIGN="LEFT" PORT="vorp_approx_out"></TD></TR></TABLE>>];
  }
  silver__dim_teams:team_id_out:e -> silver__fct_games:home_team_id_in:w;
  silver__dim_teams:team_id_out:e -> silver__fct_games:away_team_id_in:w;
  silver__fct_games:game_id_out:e -> silver__fct_possessions:game_id_in:w;
  silver__fct_games:game_id_out:e -> silver__fct_play_by_play:game_id_in:w;
  silver__fct_games:game_id_out:e -> silver__fct_shots:game_id_in:w;
  silver__fct_games:game_id_out:e -> silver__fct_lineups:game_id_in:w;
  silver__fct_games:game_id_out:e -> silver__fct_boxscores:game_id_in:w;
  silver__dim_players:player_id_out:e -> silver__fct_boxscores:player_id_in:w;
  gold__team_game_stats:team_id_out:e -> gold__team_season_four_factors:team_id_in:w;
  gold__team_game_stats:team_id_out:e -> gold__team_season_elo:team_id_in:w;
  silver__fct_lineups:player_ids_str_out:e -> gold__lineup_season_stats:player_ids_str_in:w;
  silver__fct_boxscores:player_id_out:e -> gold__player_game_stats:player_id_in:w;
  gold__player_game_stats:player_id_out:e -> gold__player_season_stats:player_id_in:w;
}
